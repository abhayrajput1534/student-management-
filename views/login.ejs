<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login | Student Management System</title>
  <link rel="stylesheet" href="/css/style.css?v=2" />
</head>
<body>
  <div class="login-wrapper">
    <div class="login-card">
      <div class="login-left">
        <div class="cap-icon">🎓</div>
        <h1>STUDENT<span>MANAGEMENT SYSTEM</span></h1>
        <div class="divider"></div>
        <p class="tagline">Manage Students. Manage Future.</p>
        <div class="wave"></div>
      </div>

      <div class="login-right">
        <h2>Welcome Back!</h2>
        <p class="subtitle">Login to your account to continue</p>

        <% if (error) { %>
          <div class="error-msg"><%= error %></div>
        <% } %>

        <form action="/login" method="POST">
          <div class="form-group">
            <label for="username">Username</label>
            <div class="input-icon-wrapper">
              <span class="icon-left">👤</span>
              <input type="text" id="username" name="username" placeholder="Enter your username" style="padding-left: 40px;" required />
            </div>
          </div>

          <div class="form-group">
            <label for="password">Password</label>
            <div class="input-icon-wrapper has-right-icon">
              <span class="icon-left">🔒</span>
              <input type="password" id="password" name="password" placeholder="Enter your password" style="padding-left: 40px; padding-right: 40px;" required />
              <button type="button" class="icon-right-btn" id="togglePassword">👁</button>
            </div>
          </div>

          <button type="submit" class="btn btn-block">➡ Login</button>
        </form>

        <div class="or-divider">OR</div>

        <button type="button" id="loginAsAdminBtn" class="btn btn-outline btn-block">👤 Login as Admin (fill demo credentials)</button>

        <p class="login-footer-text">Don't have an account? <a href="#">Contact Admin</a></p>
      </div>
    </div>
  </div>

  <script src="/js/script.js"></script>
</body>
</html>
