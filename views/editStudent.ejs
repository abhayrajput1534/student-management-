<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Student | Student Management System</title>
  <link rel="stylesheet" href="/css/style.css?v=2" />
</head>
<body>
  <div class="app-wrapper">
    <%- include('partials/sidebar') %>

    <div class="main-content" id="mainContent">
      <%- include('partials/topbar') %>

      <div class="container">
        <div class="form-card">
          <div class="form-header">
            <div class="form-icon">✏️</div>
            <div>
              <h3>Edit Student</h3>
              <p>Update the details of this student.</p>
            </div>
          </div>

          <% if (error) { %>
            <div class="error-msg"><%= error %></div>
          <% } %>

          <form action="/students/edit/<%= student._id %>?_method=PUT" method="POST">
            <div class="form-grid">
              <div class="form-group">
                <label for="StudentID">Student ID</label>
                <input type="text" id="StudentID" name="StudentID" value="<%= student.StudentID %>" required />
              </div>

              <div class="form-group">
                <label for="Name">Name</label>
                <input type="text" id="Name" name="Name" value="<%= student.Name %>" required />
              </div>

              <div class="form-group">
                <label for="RollNo">Roll Number</label>
                <input type="text" id="RollNo" name="RollNo" value="<%= student.RollNo %>" required />
              </div>

              <div class="form-group">
                <label for="Course">Course</label>
                <select id="Course" name="Course" required>
                  <% courses.forEach(function(c) { %>
                    <option value="<%= c %>" <%= student.Course === c ? 'selected' : '' %>><%= c %></option>
                  <% }); %>
                </select>
              </div>

              <div class="form-group">
                <label for="Semester">Semester</label>
                <select id="Semester" name="Semester" required>
                  <% semesters.forEach(function(s) { %>
                    <option value="<%= s %>" <%= String(student.Semester) === String(s) ? 'selected' : '' %>>Semester <%= s %></option>
                  <% }); %>
                </select>
              </div>

              <div class="form-group">
                <label for="Mobile">Mobile Number</label>
                <div class="input-icon-wrapper">
                  <span class="icon-left">📞</span>
                  <input type="text" id="Mobile" name="Mobile" style="padding-left: 40px;" value="<%= student.Mobile %>" required />
                </div>
              </div>

              <div class="form-group">
                <label for="Email">Email</label>
                <div class="input-icon-wrapper">
                  <span class="icon-left">✉️</span>
                  <input type="email" id="Email" name="Email" style="padding-left: 40px;" value="<%= student.Email %>" required />
                </div>
              </div>
            </div>

            <div class="form-actions">
              <a href="/students" class="btn btn-outline">⬅ Cancel</a>
              <button type="submit" class="btn">💾 Update Student</button>
            </div>
          </form>
        </div>
      </div>

      <div class="page-footer">
        <span>© <%= new Date().getFullYear() %> Student Management System. All rights reserved.</span>
        <span>Designed with ❤️ for better education.</span>
      </div>
    </div>
  </div>

  <script src="/js/script.js"></script>
</body>
</html>
